{
    "name": "taskflow-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "start": "node dist/index.js",
        "postinstall": "prisma generate",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "typecheck:vercel": "tsc --noEmit -p tsconfig.vercel.json"
    },
    "dependencies": {
        "@prisma/client": "^4.16.0",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "google-auth-library": "^10.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.0",
        "prisma": "^4.16.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.4"
    }
}