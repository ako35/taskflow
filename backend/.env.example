DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
# Prisma CLI (migrate/db push) icin pooler'siz direct baglanti. Local'de
# DATABASE_URL ile ayni; prod'da (Neon) DATABASE_URL pooled (-pooler), bu direct olur.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# E-posta/sifre girisleri icin JWT imzalama anahtari - rastgele, uzun bir deger uretin (orn. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
# Mobil uygulama (apps/mobile) için opsiyonel - Google Cloud Console'da ayrı OAuth client'lar oluşturulduğunda doldurulur
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
FRONTEND_URL=https://your-project.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=your-smtp-user@gmail.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Mobil push bildirimleri icin opsiyonel - Expo projesinde "Enhanced Security" aciksa gerekir (expo.dev hesap ayarlarindan alinir)
EXPO_ACCESS_TOKEN=
