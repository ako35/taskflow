# Expo/React Native (apps/mobile) getirdiği peer bağımlılıkları npm'in katı peer
# çözümlemesiyle çakışıyor (ör. jest-expo@57.0.5 -> @react-native/jest-preset@^0.86.3
# ve react-native@0.86.2 -> @react-native/jest-preset@0.86.2). Kök lockfile
# commitlenmediği için Vercel her derlemede bağımlılıkları sıfırdan çözüyor;
# bu ayar olmadan `npm install` ERESOLVE ile başarısız oluyor.
legacy-peer-deps=true
